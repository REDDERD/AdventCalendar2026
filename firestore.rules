rules_version = '2';
// [ADM-2] Security comes from these rules, not from hiding UI in the client.
// ADMIN_UID must match src/config.ts (use `npm run admin:set-uid -- <uid>`).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.uid == 'ObgMRpvygJdMKKbabQHZuvho7992'; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isActiveMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    match /users/{uid} {
      allow read: if isAdmin() || isSelf(uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isSelf(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt'])
            && request.resource.data.lastSeenAt == request.time);
    }
    match /usernames/{username} {
      allow read, write: if isAdmin();
    }
    // DECISIONS.md #76: the Zauberwort is kept here so the admin can re-issue invitations.
    match /secrets/{uid} {
      allow read, write: if isAdmin();
    }
    match /saves/{uid} {
      allow read, write: if isAdmin() || (isSelf(uid) && isActiveMember());
    }
    match /personal/{uid} {
      allow read: if isAdmin() || (isSelf(uid) && isActiveMember());
      allow write: if isAdmin();
    }
    // DECISIONS.md #78: the Rangliste. One public line per real player (character
    // name, house, house points); test accounts, including the admin, never get one.
    match /leaderboard/{uid} {
      allow read: if isAdmin() || isActiveMember();
      allow create, update: if isSelf(uid) && isActiveMember()
        && get(/databases/$(database)/documents/users/$(uid)).data.isTest != true
        && request.resource.data.keys().hasOnly(['name', 'house', 'points', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.house in ['gryffindor', 'hufflepuff', 'ravenclaw', 'slytherin']
        && request.resource.data.points is int
        && request.resource.data.points >= 0 && request.resource.data.points <= 10000
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }
    match /events/{eventId} {
      allow create: if isActiveMember()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
