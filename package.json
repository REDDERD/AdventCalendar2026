{
  "name": "hogwarts-advent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emu": "vite --mode emulator",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-hogwarts",
    "build": "npm run content:compile && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && npm run content:lint",
    "test": "npm run content:compile && vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-hogwarts \"vitest run -c vitest.rules.config.ts\"",
    "content:compile": "tsx scripts/compile-ink.ts",
    "content:lint": "npm run content:compile && tsx scripts/lint-content.ts",
    "assets:check": "tsx scripts/check-assets.ts",
    "admin:set-uid": "tsx scripts/set-admin-uid.ts",
    "admin:set-password": "tsx scripts/set-password.ts",
    "test:e2e": "npm run content:compile && playwright test"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "firebase": "^12.19.0",
    "inkjs": "^2.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "firebase-admin": "^14.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@firebase/app": "0.16.2"
  }
}
